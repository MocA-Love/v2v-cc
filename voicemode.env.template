# VoiceMode configuration for v2v-cc
# Copy to ~/.voicemode/voicemode.env and fill in your API key

# === Required ===
OPENAI_API_KEY=your-openai-api-key-here

# === STT Settings ===
VOICEMODE_SKIP_TTS=true
VOICEMODE_WHISPER_LANGUAGE=ja
VOICEMODE_PREFER_LOCAL=true
VOICEMODE_STT_BASE_URLS=http://localhost:2022/v1
VOICEMODE_WHISPER_MODEL=base
VOICEMODE_STT_PROMPT=こんにちは、プログラミングについて日本語で話しましょう。コード、関数、変数、TypeScript、Python、React

# === VAD / Recording ===
VOICEMODE_VAD_AGGRESSIVENESS=3
VOICEMODE_SILENCE_THRESHOLD_MS=500
VOICEMODE_CHIME_LEADING_SILENCE=0.5

# === Tools ===
VOICEMODE_TOOLS_ENABLED=converse,service

# === Wait Phrases ===
VOICEMODE_WAIT_PHRASES=待って,ちょっと待って,wait
VOICEMODE_WAIT_DURATION=30.0
